BOT_PREFIX=.
BOT_OWNER_JID=
# Optional: LID shown by WhatsApp for the owner account
BOT_OWNER_LID=
BOT_MAX_FILE_SIZE=100
BOT_DOWNLOAD_TIMEOUT=30000
BOT_TEMP_DIR=tmp
BOT_SESSION_DIR=sessions
BOT_LOG_DIR=logs
BOT_DATA_DIR=data
BOT_RATE_LIMIT_WINDOW_MS=3000
BOT_RATE_LIMIT_MAX=4
BOT_PLUGIN_TIMEOUT_MS=60000
BOT_REQUIRE_LINKED_USERS=true
BOT_INVITE_TTL_MS=600000
BOT_ANTI_DELETE=true
BOT_ANTI_EDIT=true
BOT_ANTI_DELETE_TARGET_JID=
BOT_ANTISPAM_WINDOW_SEC=10
BOT_ANTISPAM_MAX_MESSAGES=6
BOT_ANTISPAM_MAX_WARNINGS=3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_MAX_PROMPT_LENGTH=4000
OPENAI_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_MAX_PROMPT_LENGTH=4000
GEMINI_TIMEOUT_MS=45000
# PORT is automatically set by hosting platforms like Render
# Do not set this manually unless needed for local testing
VT_API_KEY=
VT_ALLOW_UPLOAD=false
